{
  "name": "jarvis",
  "productName": "J.A.R.V.I.S.",
  "version": "0.1.0",
  "private": true,
  "description": "J.A.R.V.I.S. desktop HUD for Hermes",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac --arm64 -c.extraMetadata.jarvisRoot=\"$(cd .. && pwd)\"",
    "install-app": "npm run dist && rm -rf \"/Applications/J.A.R.V.I.S.app\" && cp -R \"release/mac-arm64/J.A.R.V.I.S.app\" /Applications/"
  },
  "build": {
    "appId": "ai.hermes.jarvis",
    "productName": "J.A.R.V.I.S.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/mac-arm64/**",
      "!dist/builder-*",
      "dist-electron/**",
      "assets/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dir"
      ],
      "extendInfo": {
        "CFBundleName": "J.A.R.V.I.S",
        "CFBundleDisplayName": "J.A.R.V.I.S.",
        "NSMicrophoneUsageDescription": "J.A.R.V.I.S. listens for \"Hey Jarvis\" and your spoken requests.",
        "LSUIElement": false
      }
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "framer-motion": "^13.4.4",
    "lightweight-charts": "^5.2.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
